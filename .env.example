# Sepolia Public Testnet Configuration (NEVER commit your actual .env file)
# Obtain a free Sepolia RPC URL from Alchemy, Infura, QuickNode, or public RPCs (e.g., https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer throwaway private key (hex string with or without 0x)
# DO NOT paste your main wallet private key. Only use a generated test account for Sepolia.
DEPLOYER_PRIVATE_KEY=
